<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AromaEssence - น้ำมันหอมระเหยออแกนิคพรีเมียม</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&family=Prompt:wght@300;500;700&display=swap');
    body { font-family: 'Prompt', 'Plus Jakarta Sans', sans-serif; }
    .hero-bg { background: radial-gradient(circle at 10% 20%, #FDFBF7 0%, #E2E2D5 90%); }
    .card-neo { border: 3px solid #2D3748; box-shadow: 6px 6px 0px #2D3748; transition: all 0.2s ease; }
    .card-neo:hover { transform: translate(-3px, -3px); box-shadow: 10px 10px 0px #2D3748; }
  </style>
</head>
<body class="hero-bg text-gray-800">

  <!-- Navigation -->
  <nav class="flex justify-between items-center px-8 py-6 max-w-7xl mx-auto">
    <a href="index.html" class="text-2xl font-extrabold tracking-wider text-green-900">AROMA.</a>
    <div class="space-x-8 font-medium">
      <a href="index.html" class="text-green-700 font-bold border-b-2 border-green-700 pb-1">หน้าแรก</a>
