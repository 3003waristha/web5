<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact - AromaEssence</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Prompt:wght@300;500;700;900&display=swap');
    body { font-family: 'Prompt', sans-serif; background-color: #FFF9F2; }
    .card-neo { border: 3px solid #2D3748; box-shadow: 6px 6px 0px #2D3748; }
  </style>
</head>
<body class="text-gray-800">

  <nav class="flex justify-between items-center px-8 py-6 max-w-7xl mx-auto">
    <a href="index.html" class="text-2xl font-extrabold text-green-900">AROMA.</a>
    <div class="space-x-8 font-medium">
      <a href="index.html" class="hover:text-green-700">หน้าแรก</a>
      <a href="services.html" class="hover:text-green-700">บริการ</a>
      <a href="work.html" class="hover:text-green-700">ผลงาน</a>
      <a href="process.html" class="hover:text-green-700">ขั้นตอนการผลิต</a>
      <a href="contact.html" class="text-green-700 font-bold border-b-2 border-green-700 pb-1">ติดต่อเรา</a>
    </div>
  </nav>

  <section class="max-w-4xl mx-auto px-8 py-12">
    <div class="bg-orange-100 p-10 rounded-3xl card-neo">
      <h1 class="text-5xl font-black mb-6">GET IN TOUCH</h1>
      <form class="space-y-4">
        <div>
          <label class="block font-bold mb-2">ชื่อผู้ติดต่อ</label>
          <input type="text" class="w-full p-4 rounded-xl border-2 border-gray-800 focus:outline-none" placeholder="คุณสมชาย">
        </div>
        <div>
          <label class="block font-bold mb-2">อีเมล</label>
          <input type="email" class="w-full p-4 rounded-xl border-2 border-gray-800 focus:outline-none" placeholder="hello@example.com">
        </div>
        <div>
          <label class="block font-bold mb-2">ข้อความ</label>
          <textarea class="w-full p-4 rounded-xl border-2 border-gray-800 h-32 focus:outline-none" placeholder="รายละเอียดที่ต้องการติดต่อ..."></textarea>
        </div>
        <button type="button" class="w-full bg-green-800 text-white font-bold p-4 rounded-xl card-neo hover:bg-green-700">ส่งข้อความ</button>
      </form>
    </div>
  </section>

</body>
</html>
